see a doctor","f":"Manrope","s":30,"w":800,"lh":40.5,"a":"LEFT","va":"TOP","r":"HEIGHT"}},{"id":"807:15418","x":33,"y":135,"w":373,"h":40,"t":"F","n":"Reviewed by","c":1,"ch":[{"id":"807:15419","x":0,"y":0,"w":40,"h":40,"t":"F","n":"Avatar","p":[{"k":"s","c":"rgb(242,232,255)"}],"r":999,"c":1,"ch":[{"id":"807:15420","x":9.5,"y":11,"w":21,"h":18,"t":"T","n":"AM","p":[{"k":"s","c":"rgb(125,59,237)"}],"tx":{"v":"AM","f":"Manrope","s":13,"w":800,"lh":17.55,"a":"LEFT","va":"TOP","r":"WIDTH_AND_HEIGHT"}}]},{"id":"807:15421","x":52,"y":3,"w":321,"h":34,"t":"F","n":"Text","c":1,"ch":[{"id":"807:15422","x":0,"y":0,"w":321,"h":18,"t":"T","n":"Medically reviewed by Dr. Arjun Mehta, Cardiologist","p":[{"k":"s","c":"rgb(15,23,42)"}],"tx":{"v":"Medically reviewed by Dr. Arjun Mehta, Cardiologist","f":"Manrope","s":13,"w":700,"lh":17.55,"a":"LEFT","va":"TOP","r":"WIDTH_AND_HEIGHT"}},{"id":"807:15423","x":0,"y":18,"w":184,"h":16,"t":"T","n":"5 min read · Updated 12 Nov 2026","p":[{"k":"s","c":"rgb(100,116,139)"}],"tx":{"v":"5 min read · Updated 12 Nov 2026","f":"Manrope","s":12,"w":500,"lh":16.2,"a":"LEFT","va":"TOP","r":"WIDTH_AND_HEIGHT"}}]}]},{"id":"807:15424","x":33,"y":193,"w":922,"h":260,"t":"F","n":"Article image","p":[{"k":"i","r":"a505d822397b1d3a9938b3603f2b2009b0f10fef","m":"FIT"}],"k":{"p":{"k":"s","c":"rgb(226,232,240)"},"w":1,"a":"INSIDE"},"r":16,"c":1},{"id":"807:15425","x":33,"y":471,"w":922,"h":40,"t":"T","n":"Blood pressure is the force of blood against the walls of your arteries. When it stays high for a long time, it strains the heart, kidneys and blood vessels. Most people with high blood pressure feel completely well, which is why regular checks matter.","p":[{"k":"s","c":"rgb(51,65,85)"}],"tx":{"v":"Blood pressure is the force of blood against the walls of your arteries. When it stays high for a long time, it strains the heart, kidneys and blood vessels. Most people with high blood pressure feel completely well, which is why regular checks matter.","f":"Manrope","s":15,"w":500,"lh":20.25,"a":"LEFT","va":"TOP","r":"HEIGHT"}},{"id":"807:15426","x":33,"y":529,"w":223,"h":28,"t":"T","n":"What counts as high?","p":[{"k":"s","c":"rgb(15,23,42)"}],"tx":{"v":"What counts as high?","f":"Manrope","s":21,"w":800,"lh":28.35,"a":"LEFT","va":"TOP","r":"WIDTH_AND_HEIGHT"}},{"id":"807:15427","x":33,"y":575,"w":922,"h":60,"t":"T","n":"A reading is written as two numbers, for example 120/80 mmHg. A reading of 140/90 or higher on repeated checks on different days is usually treated as high blood pressure. One high reading, for example after a walk or when you are anxious, does not mean you have the condition.","p":[{"k":"s","c":"rgb(51,65,85)"}],"tx":{"v":"A reading is written as two numbers, for example 120/80 mmHg. A reading of 140/90 or higher on repeated checks on different days is usually treated as high blood pressure. One high reading, for example after a walk or when you are anxious, does not mean you have the condition.","f":"Manrope","s":15,"w":500,"lh":20.25,"a":"LEFT","va":"TOP","r":"HEIGHT"}},{"id":"807:15428","x":33,"y":653,"w":186,"h":28,"t":"T","n":"Signs to watch for","p":[{"k":"s","c":"rgb(15,23,42)"}],"tx":{"v":"Signs to watch for","f":"Manrope","s":21,"w":800,"lh":28.35,"a":"LEFT","va":"TOP","r":"WIDTH_AND_HEIGHT"}},{"id":"807:15429","x":33,"y":699,"w":922,"h":20,"t":"T","n":"• Headache, dizziness or a pounding heartbeat can happen, but many people have no signs at all.","p":[{"k":"s","c":"rgb(51,65,85)"}],"tx":{"v":"•  Headache, dizziness or a pounding heartbeat can happen, but many people have no signs at all.","f":"Manrope","s":15,"w":500,"lh":20.25,"a":"LEFT","va":"TOP","r":"HEIGHT"}},{"id":"807:15430","x":33,"y":737,"w":922,"h":20,"t":"T","n":"• Do not rely on how you feel. Measure it at home, at the same time each day, sitting and rested for 5 minutes.","p":[{"k":"s","c":"rgb(51,65,85)"}],"tx":{"v":"•  Do not rely on how you feel. Measure it at home, at the same time each day, sitting and rested for 5 minutes.","f":"Manrope","s":15,"w":500,"lh":20.25,"a":"LEFT","va":"TOP","r":"HEIGHT"}},{"id":"807:15431","x":33,"y":775,"w":922,"h":20,"t":"T","n":"• Write the readings down or save them in the app so your doctor can see the pattern.","p":[{"k":"s","c":"rgb(51,65,85)"}],"tx":{"v":"•  Write the readings down or save them in the app so your doctor can see the pattern.","f":"Manrope","s":15,"w":500,"lh":20.25,"a":"LEFT","va":"TOP","r":"HEIGHT"}},{"id":"807:15432","x":33,"y":813,"w":217,"h":28,"t":"T","n":"When to see a doctor","p":[{"k":"s","c":"rgb(15,23,42)"}],"tx":{"v":"When to see a doctor","f":"Manrope","s":21,"w":800,"lh":28.35,"a":"LEFT","va":"TOP","r":"WIDTH_AND_HEIGHT"}},{"id":"807:15433","x":33,"y":859,"w":922,"h":40,"t":"T","n":"See a doctor within a few days if your home readings stay at 140/90 or above on two or three different days, or if you already take blood pressure medicine and the numbers are creeping up. A cardiologist can check your heart, review tests and adjust treatment.","p":[{"k":"s","c":"rgb(51,65,85)"}],"tx":{"v":"See a doctor within a few days if your home readings stay at 140/90 or above on two or three different days, or if you already take blood pressure medicine and the numbers are creeping up. A cardiologist can check your heart, review tests and adjust treatment.","f":"Manrope","s":15,"w":500,"lh":20.25,"a":"LEFT","va":"TOP","r":"HEIGHT"}},{"id":"807:15434","x":33,"y":917,"w":922,"h":201,"t":"F","n":"Book card / Doctor","p":[{"k":"s","c":"rgb(236,241,255)"}],"k":{"p":{"k":"s","c":"rgb(203,213,225)"},"w":1,"a":"INSIDE"},"r":18,"c":1,"ch":[{"id":"807:15435","x":19,"y":19,"w":198,"h":15,"t":"T","n":"DOCTORS WHO CAN HELP WITH THIS","p":[{"k":"s","c":"rgb(3,28,84)"}],"tx":{"v":"DOCTORS WHO CAN HELP WITH THIS","f":"Manrope","s":11,"w":800,"lh":14.85,"a":"LEFT","va":"TOP","r":"WIDTH_AND_HEIGHT"}},{"id":"807:15436","x":19,"y":46,"w":884,"h":108,"t":"F","n":"Doctor row","p":[{"k":"s","c":"rgb(255,255,255)"}],"k":{"p":{"k":"s","c":"rgb(226,232,240)"},"w"